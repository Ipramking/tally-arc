# Address of the deployed TallyRegistry (on whichever chain you target below).
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Which Arc network the studio targets.
#   5042     = Arc Mainnet (default)
#   5042002  = Arc Testnet (free dry-run; fund via faucet.circle.com)
# The register flow's EIP-712 chainId and the badge API both follow this.
NEXT_PUBLIC_ARC_CHAIN_ID=5042

# Optional RPC override (defaults to the verified public endpoint for the
# chosen chain: rpc.mainnet.arc.io or rpc.testnet.arc.io).
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
