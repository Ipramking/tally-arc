{
  "manifest_version": 3,
  "name": "Tally: Contract Provenance",
  "version": "0.2.0",
  "description": "Provenance badges for contracts on supported block explorers: Verified, Control proven, Stale, Self-attested or Unverified.",
  "homepage_url": "https://tallyarc.tech",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://explorer.arc.io/*",
        "https://explorer.testnet.arc.io/*",
        "https://scan.bohr.life/*",
        "https://scan.botchain.ai/*"
      ],
      "js": [
        "chains.generated.js",
        "lib/safe-url.js",
        "lib/status.js",
        "content/content.js"
      ],
      "css": ["content/badges.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://rpc.mainnet.arc.io/*",
    "https://rpc.testnet.arc.io/*",
    "https://rpc.bohr.life/*",
    "https://rpc.botchain.ai/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
