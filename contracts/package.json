{
  "name": "tally-contracts",
  "version": "0.2.0",
  "private": true,
  "description": "Tally registry contracts: on-chain contract provenance for EVM chains",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:demo": "hardhat run scripts/deploy-demo.js",
    "register": "hardhat run scripts/register.js",
    "deploy:arc": "hardhat run scripts/deploy.js --network arc",
    "deploy:arcTestnet": "hardhat run scripts/deploy.js --network arcTestnet",
    "deploy:demo:arc": "hardhat run scripts/deploy-demo.js --network arc",
    "deploy:demo:arcTestnet": "hardhat run scripts/deploy-demo.js --network arcTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "^18.0.7"
  }
}
