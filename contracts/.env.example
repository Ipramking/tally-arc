# Deployer wallet private key (funded with native USDC gas on Arc).
# NEVER commit the real value. Copy this file to .env and fill it in.
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides. Defaults are the verified public endpoints.
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
