# Deployer wallet private key, funded with the chain's native gas token.
# NEVER commit the real value. Copy this file to .env and fill it in.
# Use a fresh wallet that holds nothing else.
DEPLOYER_PRIVATE_KEY=

# Optional RPC overrides. Defaults come from ../chains.json.
# Variable name = chain key upper-cased, dashes -> underscores, plus _RPC_URL.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
