      "input": "0X0f399C0143CAd70b43D18a5696026B0cEdcA0cCb",
      "expected": false
    },
    {
      "input": "0x0f399C0143CAd70b43D18a5696026B0cEdcA0cC",
      "expected": false
    },
    {
      "input": "0x0f399C0143CAd70b43D18a5696026B0cEdcA0cCbb",
      "expected": false
    },
    {
      "input": "0xzf399C0143CAd70b43D18a5696026B0cEdcA0cCb",
      "expected": false
    },
    {
      "input": " 0x0f399C0143CAd70b43D18a5696026B0cEdcA0cCb",
      "expected": false
    },
    {
      "input": "",
      "expected": false
    },
    {
      "input": null,
      "expected": false
    }
  ]
}
